<div class="tarjeta" style="max-width: 500px; margin: 0 auto;">
    <img src="<%= mascota.imagen %>" alt="Foto de la mascota <%= mascota.nombre %>">
    <h1><%= mascota.nombre %></h1>
    <p><strong>Especie:</strong> <%= mascota.especie %></p>
    <p><strong>Edad:</strong> <%= mascota.edad %> años</p>
    <p><strong>Estado actual:</strong> <%= mascota.estado %></p>
    <p><strong>Descripción:</strong> <%= mascota.descripcion %></p>
    
    <br>
    <a href="/mascotas" class="btn" style="background-color: #6c757d;">Volver al catálogo</a>
</div>